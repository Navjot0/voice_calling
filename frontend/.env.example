# Base URL of the extension-calling Spring Boot backend.
# No trailing slash and no /api/v1/voice suffix - that path is appended
# automatically by src/api/client.ts.
#
# Local development (backend running on your machine):
VITE_API_BASE_URL=http://localhost:8080
#
# Linux server deployment example (backend running on the FreeSWITCH box):
# VITE_API_BASE_URL=http://192.168.1.3:8080

# Optional: comma-separated extensions the UI should always treat as
# protected (hides their Delete button, shows "Protected Extension").
# Defaults to 1001,1002, matching the backend's default
# freeswitch.directory.protected-extensions. Override this only if the
# backend is configured with a different protected-extensions list.
# VITE_PROTECTED_EXTENSIONS=1001,1002
